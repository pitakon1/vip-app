# ===================== 数据库配置 =====================
# 全项目使用同步 Session，驱动固定为 psycopg2（写 asyncpg 会被自动改写）
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rental_db
# 连接池（按 worker 数收敛，避免打满 PG max_connections）
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ===================== Redis 配置 =====================
REDIS_URL=redis://localhost:6379/0

# ===================== 安全配置 =====================
SECRET_KEY=super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# PII 字段加密密钥（护照号/证件号/银行账户）。支持 Fernet Key 或任意口令；
# 非 DEBUG 环境必须显式配置，否则启动自检报错、加解密拒绝执行。
PII_ENCRYPTION_KEY=change-me-pii-key

# ===================== 速率限制 =====================
RATE_LIMIT_ENABLED=true
# 全局默认限额（对所有路由生效）
RATE_LIMIT_DEFAULT=300/minute
# 登录/注册/刷新令牌等凭证类接口限额
RATE_LIMIT_AUTH=10/minute
# 留空时：DEBUG 用进程内存，非 DEBUG 用 REDIS_URL。
# 多 worker 生产环境必须用 Redis，否则每个 worker 各算一份配额。
RATE_LIMIT_STORAGE_URI=

# ===================== Celery 配置 =====================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===================== CORS 配置 =====================
# 多个源用逗号分隔。默认只放开本地开发端口；生产环境必须显式列出前端域名。
# 注意：不要配置为 *（allow_credentials=True 时等于对任意站点开放）。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081

# ===================== 应用配置 =====================
APP_NAME=房地产租赁管理系统 API
APP_VERSION=1.0.0
DEBUG=false
# Uvicorn worker 数量
WEB_CONCURRENCY=4

# ===================== 文件输出目录 =====================
# 电子签合同渲染输出目录
CONTRACT_OUTPUT_DIR=./contracts
# 每日备份输出目录（生产可指向挂载盘/对象存储挂载点）
BACKUP_DIR=./backups
# 历史备份保留天数（超期文件在每次备份后清理）
BACKUP_RETENTION_DAYS=14

# ===================== 考勤定位（GPS 半径打卡）=====================
# 打卡半径（km），默认 0.5km（500 米），超出需填外勤申请
ATTENDANCE_RADIUS_KM=0.5
# 考勤基准地址（公司/办公点），由管理员在 /geo/geocode 定位后写入
ATTENDANCE_OFFICE_LAT=13.7563
ATTENDANCE_OFFICE_LNG=100.5018

# ===================== 第三方集成（可选，缺省走 mock 降级） =====================
# 未配置对应 Key 时，该能力走站内 mock/占位响应，不影响业务主流程；
# 上线/财务结算前务必填入真实凭证，并以启动自检日志核对是否处于 mock 模式。

# --- AI 应用（OpenAI 兼容 /chat/completions）---
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- 电子签合同 HMAC/RSA 签名密钥（生产必改）---
# CONTRACT_SIGNING_SECRET=change-me-signing-secret

# --- Google Maps（地图找房 / ZIP 考勤定位）---
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_ORIGIN=

# --- Google 翻译（Cloud Translation v2）---
# GOOGLE_TRANSLATE_API_KEY=
# GOOGLE_TRANSLATE_V3_PROJECT=

# --- 支付渠道（Stripe / 微信 / Wise 等）---
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# WECHAT_API_KEY=xxx
# WISE_API_KEY=xxx
