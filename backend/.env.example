# ===================== 数据库配置 =====================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rental_db

# ===================== Redis 配置 =====================
REDIS_URL=redis://localhost:6379/0

# ===================== 安全配置 =====================
SECRET_KEY=super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===================== MinIO 对象存储配置 =====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rental
MINIO_SECURE=false

# ===================== Celery 配置 =====================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===================== CORS 配置 =====================
# 多个源用逗号分隔，例如: http://localhost:3000,http://localhost:8080
CORS_ORIGINS=*

# ===================== 应用配置 =====================
APP_NAME=房地产租赁管理系统 API
APP_VERSION=1.0.0
DEBUG=false

# ===================== 第三方集成（可选，缺省走 mock 降级） =====================
# 未配置对应 Key 时，该能力走站内 mock/占位响应，不影响业务主流程；
# 上线/财务结算前务必填入真实凭证，并以启动自检日志核对是否处于 mock 模式。

# --- AI 应用（OpenAI 兼容 /chat/completions）---
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- 电子签合同 HMAC/RSA 签名密钥（生产必改）---
# CONTRACT_SIGNING_SECRET=change-me-signing-secret

# --- Google Maps（地图找房 / ZIP 考勤定位）---
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_ORIGIN=

# --- Google 翻译（Cloud Translation v2）---
# GOOGLE_TRANSLATE_API_KEY=
# GOOGLE_TRANSLATE_V3_PROJECT=

# --- 支付渠道（Stripe / 微信 / Wise 等）---
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# WECHAT_API_KEY=xxx
# WISE_API_KEY=xxx
