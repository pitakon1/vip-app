# ===================== 数据库配置 =====================
# 全项目使用同步 Session，驱动固定为 psycopg2（写 asyncpg 会被自动改写）
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rental_db
# 连接池（按 worker 数收敛，避免打满 PG max_connections）
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ===================== Redis 配置 =====================
REDIS_URL=redis://localhost:6379/0

# ===================== 安全配置 =====================
SECRET_KEY=super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# PII 字段加密密钥（护照号/证件号/银行账户）。支持 Fernet Key 或任意口令；
# 非 DEBUG 环境必须显式配置，否则启动自检报错、加解密拒绝执行。
PII_ENCRYPTION_KEY=change-me-pii-key

# ===================== 速率限制 =====================
RATE_LIMIT_ENABLED=true
# 全局默认限额（对所有路由生效）
RATE_LIMIT_DEFAULT=300/minute
# 登录/注册/刷新令牌等凭证类接口限额
RATE_LIMIT_AUTH=10/minute
# 留空时：DEBUG 用进程内存，非 DEBUG 用 REDIS_URL。
# 多 worker 生产环境必须用 Redis，否则每个 worker 各算一份配额。
RATE_LIMIT_STORAGE_URI=

# ===================== Celery 配置 =====================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===================== CORS 配置 =====================
# 多个源用逗号分隔。默认只放开本地开发端口；生产环境必须显式列出前端域名。
# 注意：不要配置为 *（allow_credentials=True 时等于对任意站点开放）。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081

# ===================== 应用配置 =====================
APP_NAME=房地产租赁管理系统 API
APP_VERSION=1.0.0
DEBUG=false
# Uvicorn worker 数量
WEB_CONCURRENCY=4

# ===================== 文件输出目录 =====================
# 电子签合同渲染输出目录
CONTRACT_OUTPUT_DIR=./contracts
# 每日备份输出目录（生产可指向挂载盘/对象存储挂载点）
BACKUP_DIR=./backups
# 历史备份保留天数（超期文件在每次备份后清理）
BACKUP_RETENTION_DAYS=14

# ===================== 考勤定位（GPS 半径打卡）=====================
# 打卡半径（km），默认 0.5km（500 米），超出需填外勤申请
ATTENDANCE_RADIUS_KM=0.5
# 考勤基准地址（公司/办公点），由管理员在 /geo/geocode 定位后写入
ATTENDANCE_OFFICE_LAT=13.7563
ATTENDANCE_OFFICE_LNG=100.5018

# ===================== 第三方集成（可选，缺省走 mock 降级） =====================
# 未配置对应 Key 时，该能力走站内 mock/占位响应，不影响业务主流程；
# 上线/财务结算前务必填入真实凭证，并以启动自检日志核对是否处于 mock 模式。

# --- AI 应用（OpenAI 兼容 /chat/completions）---
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- 电子签合同 HMAC/RSA 签名密钥（生产必改）---
# CONTRACT_SIGNING_SECRET=change-me-signing-secret

# --- Google Maps（地图找房 / 考勤定位）---
# 服务端地理编码 Key：建议在 Google Cloud 对服务器出口 IP 做限制。
# 暂留空——结算账号恢复「有效」并关联 Vip App 前，真实调用会被拒
# （You must enable Billing），此时配置也无法验证；恢复后再填。
# 未配置时服务端 geocode 走确定性站内 mock（前端地图不受影响，用浏览器端 Key）。
# GOOGLE_MAPS_SERVER_API_KEY=
# 旧名，兼容存量部署；新部署请只用上面的 SERVER 版
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_ORIGIN=

# --- 通勤测算（Google Routes API v2）---
# 复用上面的 GOOGLE_MAPS_SERVER_API_KEY / GOOGLE_MAPS_API_KEY，但需要在
# Google Cloud 额外启用「Routes API」。未配置 Key 时
# POST /public/listings/{id}/commute 返回 available=false, reason=no_key，
# 三端展示「未配置地图服务」提示，不做本地估算、不返回假数据。
# 结果按「起点/终点坐标 + 模式」写入 commute_cache，默认缓存 24h（按次计费）。
# COMMUTE_CACHE_TTL_SECONDS=86400
# COMMUTE_TIMEOUT_SECONDS=15

# --- Google 翻译（Cloud Translation v2）---
# GOOGLE_TRANSLATE_API_KEY=
# GOOGLE_TRANSLATE_V3_PROJECT=

# --- 短信（Twilio REST API）：手机号验证码 / 关键通知 ---
# 三项缺任一即视为未配置：/auth/otp/request 直接返回 503 并说明缺哪几项，
# 绝不会返回「已发送」的假成功。本地联调可留空（无法收码）。
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+14155551234

# ===================== 验证码（OTP）频控 =====================
# 同一手机号/邮箱两次发码的最小间隔（秒），超限返回 429 + Retry-After
OTP_RESEND_SECONDS=60
# 同一接收方 24 小时内最多发码条数，超限返回 429
OTP_DAILY_LIMIT=10
# 验证码有效期（分钟）与单码校验次数上限
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
# 仅本地联调：必须同时 DEBUG=true 才生效，回显 dev_code
OTP_DEV_CODE_ECHO=false

# --- 支付渠道（Stripe / LianLian / 微信 / Wise 等）---
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# WECHAT_API_KEY=xxx
# WISE_API_KEY=xxx

# --- LianLian Global 泰国收单（doc.lianlianpay.co.th）---
# 未配置商户号/私钥时该渠道 fail closed（下单直接返回未配置错误）。
# 网关默认沙箱；上线改为 https://api.lianlianpay.co.th
# LIANLIAN_MERCHANT_ID=142023010100009001
# LIANLIAN_STORE_ID=
# 商户 RSA 私钥（签名请求，可填 PEM 文本或裸 base64）
# LIANLIAN_PRIVATE_KEY=
# LianLian RSA 公钥（验签回调，可填 PEM 文本或裸 base64）
# LIANLIAN_PUBLIC_KEY=
# LIANLIAN_BASE_URL=https://sandbox-th.lianlianpay-inc.com
# 支付结果回调（指向本服务 /payments/webhook/lianlian）
# LIANLIAN_NOTIFY_URL=https://your-domain.com/payments/webhook/lianlian
# 支付完成回跳地址（收银台 POST 回跳）
# LIANLIAN_REDIRECT_URL=https://your-domain.com/payment/result
# 指定支付方式（留空=收银台展示全部已开通方式）
# LIANLIAN_PAYMENT_METHOD=
