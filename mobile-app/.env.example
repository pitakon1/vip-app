# 环境变量配置 - 开发环境
# 复制此文件为 .env 并修改值

# API 服务器地址
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Google OAuth Client ID（一键登录用，缺省空串时后端 status.mock=true 走 mock 邮箱兜底）
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Google Maps Key（App 当前无地图渲染组件，仅预留配置位；
# 位置能力走后端 /geo/geocode。后续接入 expo-maps/react-native-maps 时直接取用）
# Web（Expo Web / 浏览器）：HTTP 来源限制
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
# Android：未设应用限制
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
# iOS：未设应用限制
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=

# Expo EAS 配置 (构建后自动填充)
EXPO_PROJECT_ID=your-eas-project-id
