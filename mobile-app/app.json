{
  "expo": {
    "name": "VIP Rental",
    "slug": "vip-rental",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "viprental",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#14b8a6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vip.rental",
      "buildNumber": "1",
      "config": {
        "googleMapsApiKey": "AIzaSyACcINxwCZwtAO3ZsH37X9q47wWiJ2Gbos"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "需要相机权限用于拍摄房源照片和验房",
        "NSPhotoLibraryUsageDescription": "需要相册权限用于上传合同和照片",
        "NSLocationWhenInUseUsageDescription": "需要位置权限用于考勤打卡定位",
        "NSMicrophoneUsageDescription": "需要麦克风权限用于语音消息与录音"
      },
      "associatedDomains": [
        "applinks:viprental.com"
      ],
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.vip.rental",
      "versionCode": 1,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCx7Sg9kQhjSysruiuV8rJFXtIecdNmB6Q"
        }
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14b8a6"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "color": "#14b8a6",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "允许此应用使用您的位置用于考勤打卡。"
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-audio"
    ],
    "extra": {},
    "updates": {
      "enabled": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
